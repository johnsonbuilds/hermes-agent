# =============================================================================
# Model Configuration
#
# Hosted contract (ClawCloud): the WebUI in-process chat and per-profile
# gateways resolve credentials through the ladder/pool system, which only
# serves a bare "custom" request when a NAMED providers entry exists — a bare
# ``provider: custom`` with only ``model.api_key`` never seeds any pool
# (verified 2026-10-12). So the hosted endpoint lives as a named entry and
# ``model.provider`` points at that name. ``model.api_key``/``model.base_url``
# are intentionally duplicated: the gateway's explicit-credential short
# circuit reads them directly and is provider-name agnostic, so Telegram
# behavior is byte-identical before/after the rename. ``LLM_PROVIDER`` is
# retired by this shape (kept accepted, no longer consumed).
# =============================================================================
providers:
  clawcloud:
    base_url: "${LLM_BASE_URL}"
    api_key: "${LLM_API_KEY}"
model:
  provider: clawcloud
  base_url: "${LLM_BASE_URL}"
  default: "${LLM_MODEL_ID}"
  api_key: "${LLM_API_KEY}"
  api_mode: "chat_completions"

# =============================================================================
# Terminal Tool Configuration
# =============================================================================
terminal:
  backend: "local"
  cwd: "."
  timeout: 180
  lifetime_seconds: 300

# =============================================================================
# Persistent Memory (核心功能：长期记忆)
# =============================================================================
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200   
  user_char_limit: 1375     
  nudge_interval: 10        # 每10次对话提醒一次记忆保存

# =============================================================================
# Session Reset Policy (会话重置策略)
# =============================================================================
session_reset:
  mode: both           # 闲置或每日定时重置
  idle_minutes: 60     # 1小时不说话就重置上下文，节省Token
  at_hour: 4           # 凌晨4点强制重置

# =============================================================================
# Gateway Streaming (流式响应)
# =============================================================================
streaming:
  enabled: true        # 在Telegram中显示“打字中”状态
  transport: edit      
  edit_interval: 0.5   
  cursor: " ▉"          

# =============================================================================
# Agent Behavior
# =============================================================================
agent:
  max_turns: 50        # 单次任务最大工具调用轮数
  verbose: false       # 生产环境建议关闭详细日志
  reasoning_effort: "medium" # 适合 DeepSeek-R1 的推理档位

# =============================================================================
# Display
# =============================================================================
display:
  show_reasoning: true # 显示 DeepSeek 的思考过程
  tool_progress: all   # 显示工具调用进度
  compact: false

# =============================================================================
# Context Compression (自动压缩)
# =============================================================================
compression:
  enabled: true
  threshold: 0.50      # 占用50%窗口时开始压缩

# =============================================================================
# Toolsets (默认工具配置)
# =============================================================================
platform_toolsets:
  telegram: [hermes-telegram]
  cli: [hermes-cli]

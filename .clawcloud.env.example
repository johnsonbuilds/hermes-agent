# Hermes Agent Environment Configuration (ClawCloud / Docker Edition)
# Copy this file to .env and fill in your API keys

# =============================================================================
# CORE PATHS (CRITICAL FOR DOCKER)
# =============================================================================
# MESSAGING_CWD: The "home base" for the agent in Telegram/Discord.
# All files created or searched by the agent will default to this path.
# BEST PRACTICE: Set this to your mounted volume path to ensure work is saved.
MESSAGING_CWD=/opt/data

# HERMES_HOME: Where config.yaml and .env are stored.
# Already set to /opt/data in the official Dockerfile.
HERMES_HOME=/opt/data



# HERMES_DASHBOARD: Set to 1 to enable the Web UI
HERMES_DASHBOARD=1

# HERMES_DASHBOARD_INSECURE: Set to 1 to disable auth (ONLY for local/internal use!)
HERMES_DASHBOARD_INSECURE=1

